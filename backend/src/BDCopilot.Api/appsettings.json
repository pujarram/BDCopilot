  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=bdcopilot;Username=postgres;Password=YOUR_PASSWORD"
  },

  "Ai": {
    "Provider": "Ollama",
    "EmbeddingDimensions": 768,
