      "Endpoint": "http://localhost:11434",
      "ChatModel": "llama3.1:8b",
      "EmbeddingModel": "nomic-embed-text"
    },
    "AzureOpenAI": {
      "Endpoint": "",
      "ChatDeployment": "gpt-4o",
      "EmbeddingDeployment": "text-embedding-3-large",
      "UseEntraIdAuth": true,
      "ApiKey": null
